{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SwissDriver Lab scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "lessonId",
    "exerciseId",
    "sceneId",
    "ruleRefs",
    "objectives",
    "events",
    "rubric"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "lessonId": {
      "type": "string",
      "minLength": 1
    },
    "exerciseId": {
      "type": "string",
      "minLength": 1
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "ruleRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "timestampMs"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "timestampMs": {
            "type": "number",
            "minimum": 0
          },
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ruleRef",
          "eventType",
          "evaluation"
        ],
        "properties": {
          "ruleRef": {
            "type": "string"
          },
          "eventType": {
            "type": "string"
          },
          "evaluation": {
            "enum": [
              "pass",
              "fail",
              "not_measured"
            ]
          },
          "feedbackId": {
            "type": "string"
          }
        }
      }
    }
  }
}